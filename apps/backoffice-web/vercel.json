{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack pnpm -C ../.. install --frozen-lockfile",
  "buildCommand": "corepack pnpm -C ../.. --filter backoffice-web build",
  "outputDirectory": ".next",
  "regions": [
    "bom1"
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "agent-docs-preflight-schema-drift": true
    }
  }
}
