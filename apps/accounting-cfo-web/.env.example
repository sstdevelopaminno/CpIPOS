# Authentication: use long random values. Never commit real secrets.
ACCOUNTING_SESSION_SECRET=
ACCOUNTING_CFO_ACCESS_KEY=
ACCOUNTING_MARKETING_ACCESS_KEY=

# Google service account with Viewer/read-only access to the accounting sources.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Accounting source-of-truth IDs (configure only in Vercel environment variables).
ACCOUNTING_SPREADSHEET_ID=
SALES_DOCUMENT_SPREADSHEET_ID=

# Optional UI label.
ACCOUNTING_APP_TITLE="Cutting Point Accounting & CFO"
