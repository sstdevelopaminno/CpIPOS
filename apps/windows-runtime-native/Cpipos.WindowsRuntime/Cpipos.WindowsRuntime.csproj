<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Cpipos.WindowsRuntime</AssemblyName>
    <RootNamespace>Cpipos.WindowsRuntime</RootNamespace>
    <Version>0.1.5</Version>
    <FileVersion>0.1.5.0</FileVersion>
    <AssemblyVersion>0.1.5.0</AssemblyVersion>
    <ApplicationIcon>assets\cpipos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="assets\cpipos.ico" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>

  <Target Name="RestoreCpiposIconFromBase64" BeforeTargets="CoreCompile" Condition="!Exists('assets\cpipos.ico') And Exists('assets\cpipos.ico.b64')">
    <Message Importance="High" Text="Restoring CpIPOS Windows icon from assets\cpipos.ico.b64" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;$iconBase64 = (Get-Content -LiteralPath '&apos;$(MSBuildProjectDirectory)\assets\cpipos.ico.b64&apos;' -Raw).Trim(); [System.IO.File]::WriteAllBytes('&apos;$(MSBuildProjectDirectory)\assets\cpipos.ico&apos;', [System.Convert]::FromBase64String($iconBase64))&quot;" />
  </Target>
</Project>
